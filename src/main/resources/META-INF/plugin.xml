<!-- MypiPlugin 插件声明 -->
<idea-plugin>
    <id>com.mypi.plugin</id>
    <name>MypiPlugin</name>
    <vendor>mypi</vendor>
    <description><![CDATA[
        在 IntelliJ 内置终端跑 Pi coding agent,一键把选区定位注入 pi。<br/>
        选中代码 → Ctrl+Alt+; → 定位串填入 pi 终端(只填不发送),焦点自动切到 pi 输入行,补问题回车即可。格式可在 Settings → Tools → Pi 切换(默认 @path:行号,可选 @path#L行号)。<br/>
        <br/>
        <strong>IDE MCP 集成(2025.2+):</strong>启动 Pi 时自动注入 IDEA MCP Server,让 Pi 获得 read_file、search_symbols、build_project、debug 等全套 IDE 工具,无需手动配置。可在 Settings → Tools → Pi 关闭。
    ]]></description>

    <!-- 只依赖基础平台模块,不强绑定 Java/Ultimate -->
    <depends>com.intellij.modules.platform</depends>
    <!-- 依赖内置终端插件(Reworked Terminal,跑 pi + 注入选区) -->
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- 依赖 MCP Server 插件(2025.2+ 内置,提供 IDE 工具给 Pi 调用) -->
    <!-- optional=true:旧版 IDEA 无此插件时也能加载,通过反射降级 -->
    <depends optional="true">com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 右侧 Pi 聊天面板 -->
        <toolWindow id="Pi"
                    anchor="right"
                    icon="/icons/piToolWindow.svg"
                    factoryClass="com.mypi.plugin.PiToolWindowFactory"/>
        <!-- Settings → Tools → Pi:配置 pi 可执行路径 -->
        <projectConfigurable groupId="tools"
                             displayName="Pi"
                             id="mypi.piConfigurable"
                             instance="com.mypi.plugin.PiConfigurable"/>
    </extensions>

    <actions>
        <!-- 选区 → Pi 的快捷键动作 -->
        <action id="Mypi.SendSelection"
                class="com.mypi.plugin.SendSelectionAction"
                text="Send Selection to Pi"
                description="将当前选区作为上下文发送给 Pi">
            <!-- Ctrl+Alt+字母会被中文输入法拦截(打 p),Ctrl+Shift 又是输入法切换;
                 改 Ctrl+Alt+; 避开 Shift 与 IME 常用组合,分号无 IME 冲突 -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt SEMICOLON"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
