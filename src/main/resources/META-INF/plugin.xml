<!-- MypiPlugin 插件声明 -->
<idea-plugin>
    <id>com.mypi.plugin</id>
    <name>MypiPlugin</name>
    <vendor>mypi</vendor>
    <description><![CDATA[
        Pi coding agent integration for IntelliJ IDEA.<br/>
        选中代码 → 快捷键 → 作为上下文发送给 Pi,流式查看回复。
    ]]></description>

    <!-- 只依赖基础平台模块,不强绑定 Java/Ultimate -->
    <depends>com.intellij.modules.platform</depends>
    <!-- 依赖内置终端插件(Reworked Terminal,跑 pi + 注入选区) -->
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 右侧 Pi 聊天面板 -->
        <toolWindow id="Pi"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowProject"
                    factoryClass="com.mypi.plugin.PiToolWindowFactory"/>
        <!-- Settings → Tools → Pi:配置 pi 可执行路径 -->
        <projectConfigurable groupId="tools"
                             displayName="Pi"
                             id="mypi.piConfigurable"
                             instance="com.mypi.plugin.PiConfigurable"/>
    </extensions>

    <actions>
        <!-- 选区 → Pi 的快捷键动作 -->
        <action id="Mypi.SendSelection"
                class="com.mypi.plugin.SendSelectionAction"
                text="Send Selection to Pi"
                description="将当前选区作为上下文发送给 Pi">
            <!-- Ctrl+Alt+字母会被中文输入法拦截(打 p),Ctrl+Shift 又是输入法切换;
                 改 Ctrl+Alt+; 避开 Shift 与 IME 常用组合,分号无 IME 冲突 -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt SEMICOLON"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
